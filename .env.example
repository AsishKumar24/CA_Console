# Copy to .env and fill in. Never commit .env.

# --- Required ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Leave unset for local Docker Mongo (compose default).
# For production (EC2), point at Atlas:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ca_console

# --- URLs ---
# Local dev defaults to http://localhost:8080; on EC2 set to your public URL:
# CLIENT_URL=https://your-domain.example
# BASE_URL=https://your-domain.example

# --- First admin (used by createAdmin script) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=

# --- Password reset emails ---
EMAIL_USER=
EMAIL_PASSWORD=

# --- Compose ---
# WEB_PORT=8080
